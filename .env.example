# Google OAuth client ID (type "Web application") used by store builds.
# See docs/GOOGLE_SETUP.md.
WXT_GOOGLE_CLIENT_ID=

# Optional but recommended: a SEPARATE OAuth client for development builds
# (pnpm dev, pnpm build:dev). Register development redirect URIs only here,
# never in the production client above.
WXT_GOOGLE_CLIENT_ID_DEV=

# Required for production Firefox builds: a Firefox add-on ID you own, e.g.
# marksync@yourdomain.com (a domain you control) or the UUID that
# addons.mozilla.org assigned. The build fails if this is empty or a
# placeholder such as anything@example.org.
WXT_GECKO_ID=

# Optional, development builds only: public key that pins the Chromium
# extension ID, so Chrome, Brave and Edge share one OAuth redirect URL.
# Never added to store builds.
WXT_EXTENSION_KEY=

# Optional: the address of the web viewer (viewer/, e.g. on GitHub Pages).
# Shared-folder invitations link to its join page; without it the extension
# cannot invite anyone to a shared folder.
WXT_VIEWER_URL=

# Web viewer builds (pnpm build:viewer), see docs/GOOGLE_SETUP.md:
# a "Web application" OAuth client of the same Google Cloud project,
VITE_GOOGLE_CLIENT_ID=
# and, for the shared-folder join page (Google Picker), an API key and the
# project number.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
