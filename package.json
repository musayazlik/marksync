{
  "name": "marksync",
  "description": "Open-source bookmark sync for Chrome, Brave, Edge and Firefox, with Google Drive backups.",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/musayazlik/marksync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musayazlik/marksync.git"
  },
  "bugs": {
    "url": "https://github.com/musayazlik/marksync/issues"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:dev": "wxt build --mode development",
    "build:dev:firefox": "wxt build -b firefox --mode development",
    "build:all": "wxt build && wxt build -b firefox && wxt build -b edge && wxt build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "build:opera": "wxt build -b opera",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b edge && wxt zip -b opera",
    "build:viewer": "vite build --config viewer/vite.config.ts",
    "dev:viewer": "vite --config viewer/vite.config.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@12.11.2"
}
